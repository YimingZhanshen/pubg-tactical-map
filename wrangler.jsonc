{
  // Static-only Worker: Wrangler uploads the Vite build output as assets.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pubg-tactical-map",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
